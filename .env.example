# ===== BẮT BUỘC =====
# Lấy key tại https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ===== Bảo mật (nên đặt khi đưa app lên mạng) =====
APP_PASSWORD=

# ===== Đọc mail tự động (IMAP) =====
# iCloud:  IMAP_HOST=imap.mail.me.com  (mật khẩu = "mật khẩu cho ứng dụng" tạo ở appleid.apple.com)
# Gmail:   IMAP_HOST=imap.gmail.com    (cần bật xác minh 2 bước + App Password)
# Mail trường (Microsoft 365) thường KHÔNG cho IMAP bằng mật khẩu → hãy chuyển tiếp (forward) mail trường sang iCloud/Gmail.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# ===== Thông báo mỗi sáng =====
# ntfy: cài app "ntfy" (iOS/Android), đăng ký đúng topic dưới đây. Chọn tên dài, khó đoán (ai biết tên đều đọc được).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Link mở khi bấm vào thông báo (địa chỉ app của bạn)
APP_URL=

# Email (tuỳ chọn), vd iCloud: smtp.mail.me.com port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# ===== Nâng cao =====
# Giờ chạy bản tin (cron, giờ Paris). "off" để tắt.
DIGEST_CRON=30 7 * * *
PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# Tắt cơ chế tự chuyển model khi bị từ chối: CLAUDE_FALLBACKS=off
# WEB_SEARCH_MAX_USES=15
# DATA_DIR=./data
