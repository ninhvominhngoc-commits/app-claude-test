{
  "name": "sorbonne-copilot",
  "version": "0.1.0",
  "description": "Trợ lý cho sinh viên L1 EEA Sorbonne (Pierre et Marie Curie): kiểm chứng tin, tóm tắt campus mỗi ngày, lịch thi/deadline, gia sư Feynman + flashcards.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "digest": "node --env-file-if-exists=.env src/cli-digest.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "imapflow": "^2.12.1",
    "katex": "^0.19.1",
    "mailparser": "^3.14.5",
    "marked": "^18.2.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0"
  }
}
